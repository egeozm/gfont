{
  "name": "gfont-localize",
  "version": "1.0.0",
  "description": "CLI tool to self-host Google Fonts by downloading font files and generating local @font-face CSS",
  "type": "module",
  "bin": {
    "gfont-localize": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "web": "tsx src/server.ts",
    "web:prod": "node dist/server.js",
    "font-check": "tsx src/index.ts font-check"
  },
  "keywords": [
    "google-fonts",
    "self-host",
    "fonts",
    "cli"
  ],
  "license": "MIT",
  "dependencies": {
    "@fastify/static": "^8.1.1",
    "commander": "^13.1.0",
    "fastify": "^5.2.1",
    "fontkit": "^2.0.4",
    "jszip": "^3.10.1",
    "pdfkit": "^0.19.1",
    "postcss": "^8.5.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/pdfkit": "^0.17.6",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18"
  }
}
